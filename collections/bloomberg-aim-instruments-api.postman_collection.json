  "info": {
    "_postman_id": "9f8496c0-29f7-4e3f-a03e-bad7fe9e9ea0",
    "name": "Bloomberg Data License API (HAPI) Broker Strategies Instruments API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Provides programmatic access to Bloomberg's comprehensive financial, pricing, reference, regulatory, and alternative data covering over 50 million securities and 56,000 fields via the Hypermedia API (HAPI). The BEAP/HAPI follows a hypermedia-driven REST architecture where clients discover resources through link relations in responses.\n\nContact Support:\n Name: Bloomberg Developer Support",
      "type": "text/plain"
    }
  }
