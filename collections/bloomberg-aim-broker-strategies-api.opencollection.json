        {
          "info": {
            "name": "Get Broker Strategy Details",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/eap/request/blp/emapisvc/GetBrokerStrategyInfoWithAssetClass",
