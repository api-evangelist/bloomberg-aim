{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bloomberg Data License API (HAPI) Broker Strategies Field Search API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Field Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Field Information",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/eap/request/blp/refdata/FieldInfoRequest",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns metadata about specified Bloomberg fields, including descriptions, data types, and categories."
        },
        {
          "info": {
            "name": "Search for Fields",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/eap/request/blp/refdata/FieldSearchRequest",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches for Bloomberg fields by keyword or category."
        }
      ]
    }
  ],
  "bundled": true
}