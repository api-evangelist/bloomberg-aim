{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bloomberg Data License API (HAPI) Broker Strategies Requests API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Data Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bloomberg.com/eap/catalogs/:catalogId/requests",
            "params": [
              {
                "name": "catalogId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the catalog"
              }
            ]
          },
          "docs": "Returns all data requests in the catalog."
        },
        {
          "info": {
            "name": "Create a Data Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/eap/catalogs/:catalogId/requests",
            "params": [
              {
                "name": "catalogId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the catalog"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new data request combining a universe, field list, and trigger to produce a scheduled data output."
        },
        {
          "info": {
            "name": "Get Data Request Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bloomberg.com/eap/catalogs/:catalogId/requests/:requestId",
            "params": [
              {
                "name": "catalogId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the catalog"
              },
              {
                "name": "requestId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the data request"
              }
            ]
          },
          "docs": "Returns details of a specific data request."
        },
        {
          "info": {
            "name": "Delete a Data Request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.bloomberg.com/eap/catalogs/:catalogId/requests/:requestId",
            "params": [
              {
                "name": "catalogId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the catalog"
              },
              {
                "name": "requestId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the data request"
              }
            ]
          },
          "docs": "Deletes a specific data request."
        }
      ]
    }
  ],
  "bundled": true
}