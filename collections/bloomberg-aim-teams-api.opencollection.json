        },
        {
          "info": {
            "name": "Assign a Trader to an Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/eap/request/blp/emapisvc/AssignTrader",
            "body": {
              "type": "json",
              "data": "{}"
            }
