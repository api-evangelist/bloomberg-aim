{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bloomberg Data License API (HAPI) Broker Strategies Historical Data API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Historical Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request Historical Data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/eap/request/blp/refdata/HistoricalDataRequest",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves historical end-of-day data for a set of securities and fields over a specified date range."
        }
      ]
    }
  ],
  "bundled": true
}